{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*:/api/v*/authentication/login",
        "Period": "1m",
        "Limit": 5
      },
      {
        "Endpoint": "*:/api/v*/authentication/login-with-google",
        "Period": "1m",
        "Limit": 5
      },
      {
        "Endpoint": "*:/api/v*/authentication/register",
        "Period": "1m",
        "Limit": 3
      },
      {
        "Endpoint": "*:/api/*",
        "Period": "1m",
        "Limit": 60
      }
    ]
  },
  "Security": {
    "Headers": {
      "Enabled": true,
      "XFrameOptions": "DENY",
      "XContentTypeOptions": "nosniff",
      "XssProtection": "1; mode=block",
      "ContentSecurityPolicy": "default-src 'self'; base-uri 'self'; frame-ancestors 'self' http://localhost:* https://localhost:* https://*.vercel.app https://*.runasp.net; form-action 'self'; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self'; font-src 'self' data:",
      "ReferrerPolicy": "no-referrer",
      "PermissionsPolicy": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), accelerometer=(), gyroscope=(), fullscreen=(self), unload=(self)",
      "StrictTransportSecurity": "max-age=31536000; includeSubDomains; preload"
    },
    "Cors": {
      "Enabled": true,
      "PolicyName": "DefaultPolicy",
      "AllowedOrigins": [
      ],
      "AllowedMethods": [
        "GET",
        "POST",
        "PUT",
        "DELETE",
        "PATCH",
        "OPTIONS"
      ],
      "AllowedHeaders": [
        "Content-Type",
        "Authorization",
        "Accept-Language",
        "X-ClientId",
        "X-XSRF-TOKEN"
      ],
      "AllowCredentials": true
    },
    "Antiforgery": {
      "Enabled": true,
      "ValidateOnAllNonIdempotentActions": true,
      "HeaderName": "X-XSRF-TOKEN",
      "CookieName": "XSRF-TOKEN",
      "CookieHttpOnly": true,
      "CookieSameSite": "Strict",
      "RequireSsl": true
    },
    "RequestLimits": {
      "Enabled": true,
      "MaxRequestSizeBytes": 4194304,
      "ErrorMessage": "Request body is too large. Maximum size is {0} bytes."
    },
    "Hsts": {
      "Enabled": true,
      "Preload": true,
      "IncludeSubDomains": true,
      "MaxAgeDays": 365
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Serilog.AspNetCore": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "UploadPaths": {
    "Images": "Images",
    "Videos": "Videos",
    "Audios": "Audios",
    "Documents": "Documents"
  },
  "NetTracker": {
    "Enabled": true,
    "EnableDashboardUI": true,
    "AllowRemoteDashboardAccess": true,
    "LogRequestBody": true,
    "LogResponseBody": false,
    "LogBodyOnlyOnErrors": true,
    "LogHeaders": false,
    "MaxBodySize": 8192,
    "Storage": {
      "Type": "Database",
      "ConnectionString": "Server=db75937.public.databaseasp.net; Database=db75937; User Id=db75937; Password=Mo@123456; Encrypt=True; TrustServerCertificate=True; MultipleActiveResultSets=True;"
    },
    "Retention": {
      "DaysToKeep": 7,
      "AutoCleanup": true
    },
    "Performance": {
      "UseAsyncLogging": true,
      "MaxQueueSize": 10000,
      "EnableCaching": true
    },
    "ExcludePaths": [
      "/health",
      "/swagger",
      "/swagger-custom",
      "/favicon.ico",
      "/net-tracker",
      "/api/Statistics",
      "/api/HttpTransactions",
      "/files"
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=db75937.public.databaseasp.net; Database=db75937; User Id=db75937; Password=Mo@123456; Encrypt=True; TrustServerCertificate=True; MultipleActiveResultSets=True;",
    "LMSConnectionString": "Server=db75937.public.databaseasp.net; Database=db75937; User Id=db75937; Password=Mo@123456; Encrypt=True; TrustServerCertificate=True; MultipleActiveResultSets=True;"
  },
  "JwtSettings": {
    "Issuer": "",
    "Audience": "LmsMobile,LmsDashboard",
    "ExpiryInDays": 7,
    "RefreshTokenExpiryDays": 30,
    "Secret": "2V9usZNJoPRCwP/aPcATh1y0Xf8E7ZpCIX6uv23HdtkLEqpwt7y1IcrA7BwArgBj"
  },
  "IdentityOptions": {
    "RequiredDigit": true,
    "RequiredLength": 8,
    "RequireLowercase": true,
    "RequireUppercase": true,
    "MaxFailedAttempts": 5,
    "AllowedUserNameCharacters": "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-._@+",
    "RequireUniqueEmail": true,
    "RequireConfirmedEmail": false,
    "RequireNonAlphanumeric": false
  }
}